# ============================================================================
# Plantilla de configuracion del despliegue.
#
# Uso:  copiala a .env y rellenala.
#         Windows:  Copy-Item .env.ejemplo .env
#         Linux:    cp .env.ejemplo .env
#
# El archivo .env esta en .gitignore y NUNCA se sube al repositorio.
# Este archivo (.env.ejemplo) si se versiona, por eso no lleva ningun secreto.
# ============================================================================


# ── Base de datos ───────────────────────────────────────────────────────────
DB_NAME=SIH
DB_USER=User_app

# Clave de PostgreSQL. Se deja VACIA a proposito: docker-compose.yml usa
# ${DB_PASSWORD:?...} y detiene el arranque con un mensaje claro si falta, en
# vez de crear una base con una clave por defecto.
DB_PASSWORD=


# ── Secreto de los JWT ──────────────────────────────────────────────────────
# Obligatorio, minimo 32 caracteres. Genera SIEMPRE uno nuevo por instalacion:
#     Windows:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#     Linux:    openssl rand -base64 48
# Al cambiarlo se invalidan todos los tokens ya emitidos (los usuarios vuelven
# a iniciar sesion: no se pierde nada).
JWT_SECRETO=


# ── Que datos se cargan al crear la base por primera vez ────────────────────
# Solo se ejecuta cuando el volumen de PostgreSQL esta VACIO.
#     Instalacion de ESTE cliente (migracion) : 04_datos_cliente.sql
#     Cliente nuevo desde cero                : 03_semilla.sql
# Son ALTERNATIVOS: nunca los dos a la vez, chocarian las PRIMARY KEY.
SCRIPT_DATOS=03_semilla.sql


# ── Dominio y puertos ───────────────────────────────────────────────────────
# SITIO es la directiva de sitio de Caddy (TLS y enrutado). OJO: el puerto que
# pongas aqui es el INTERNO del contenedor, no el del host.
#     Local      : :80                -> escucha en el 80, cualquier host, sin TLS
#     Produccion : sih.tudominio.mx   -> Caddy saca el certificado HTTPS solo
SITIO=:80

# URL con la que el usuario entra en el navegador (incluye el puerto publico).
# Se usa para CORS y para los enlaces de recuperacion de contrasena.
URL_PUBLICA=http://localhost:9080

PUERTO_HTTP=9080
PUERTO_HTTPS=9443


# ── Correo (recuperacion de contrasena) ─────────────────────────────────────
# Con valores vacios la aplicacion arranca igual; solo fallaria al intentar
# enviar un correo de recuperacion.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tudominio.com

# URL publica que aparece en los enlaces de recuperacion.
FRONTEND_URL=http://localhost:9080


# ── Asesor LLM del generador de horarios (OPCIONAL) ─────────────────────────
# Vacio = el motor usa solo su heuristica, sin llamar a ninguna API externa.
IA_API_KEY=
IA_URL=https://api.openai.com/v1/chat/completions
IA_MODELO=gpt-4o-mini
